{
  "version": 1,
  "supportedExtensions": [".mp3", ".ogg", ".wav", ".m4a"],
  "naming": {
    "warnOnly": true,
    "safePattern": "^[a-z0-9][a-z0-9._-]*\\.(mp3|ogg|wav|m4a)$"
